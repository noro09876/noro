 "lines": [
  {
   "scene": "hook",
   "text": "Клиент написал.",
   "start": 0.35,
   "end": 1.597
  },
  {
   "scene": "hook",
   "text": "А ему никто не ответил.",
   "start": 1.877,
   "end": 3.481
  },
  {
   "scene": "sources",
   "text": "Заявки приходят отовсюду: сайт, директ, Телеграм, звонки.",
   "start": 3.931,
   "end": 8.244
  },
  {
   "scene": "leaks",
   "text": "Одна осталась в личке у менеджера.",
   "start": 8.644,
   "end": 10.819
  },
  {
   "scene": "leaks",
   "text": "Другая — в таблице, которую никто не открыл.",
   "start": 11.099,
   "end": 13.808
  },
  {
   "scene": "leaks",
   "text": "Третья ждала ответа до утра — и клиент ушёл к тем, кто ответил быстрее.",
   "start": 14.088,
   "end": 18.459
  },
  {
   "scene": "unify",
   "text": "Автоматизация наводит порядок.",
   "start": 19.009,
   "end": 21.124
  },
  {
   "scene": "unify",
   "text": "Все заявки попадают в одно место.",
   "start": 21.404,
   "end": 23.598
  },
  {
   "scene": "flow",
   "text": "Каждой сразу назначается ответственный.",
   "start": 23.948,
   "end": 26.267
  },
  {
   "scene": "flow",
   "text": "Клиент получает первый ответ.",
   "start": 26.547,
   "end": 28.389
  },
  {
   "scene": "flow",
   "text": "А если заявка зависла, система напомнит.",
   "start": 28.669,
   "end": 31.635
  },
  {
   "scene": "pipeline",
   "text": "И вы видите всю воронку: где каждый клиент и что с ним происходит.",
   "start": 32.035,
   "end": 36.052
  },
  {
   "scene": "cta",
   "text": "Ни одна заявка не должна теряться.",
   "start": 36.552,
   "end": 38.713
  },
  {
   "scene": "cta",
   "text": "Напишите менеджеру Brukinsta — разберём, где утекают ваши.",
   "start": 38.993,
   "end": 42.721
  }
 ],
