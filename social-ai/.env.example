# Копия этого файла с именем .env читается при запуске. Не коммитьте .env.

# Адрес и порт. По умолчанию сервер доступен только с этого компьютера.
NORO_HOST=127.0.0.1
NORO_PORT=8787

# Папка данных (база, изображения, резервные копии, master.key)
NORO_DATA_DIR=./data

# Публичный HTTPS-адрес NORO. Нужен только для Instagram (он скачивает картинки по ссылке)
# и для входа через X с другого устройства. Например, адрес бесплатного Cloudflare Tunnel.
NORO_PUBLIC_URL=

# Ключ шифрования токенов. Если не задан, создаётся data/master.key автоматически.
# Задайте свой (длинная случайная строка), если храните данные в нескольких местах.
NORO_MASTER_KEY=

# Пароль администратора для автоматического создания при первом запуске (необязательно).
NORO_ADMIN_PASSWORD=

# Отключить фоновый планировщик (только для отладки)
# NORO_SCHEDULER=off
