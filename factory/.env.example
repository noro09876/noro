# NORO AI Content Factory — пример настроек. Скопируйте в .env и заполните.
# Настоящие секреты сюда не коммитить. Ключи ИИ-провайдеров и соцсетей вводятся
# в интерфейсе (Настройки, Аккаунты) и хранятся в базе в зашифрованном виде.

NODE_ENV=production
PORT=8787
HOST=0.0.0.0
# Публичный адрес приложения. Нужен для OAuth-редиректов и публичных ссылок на медиа
# (Instagram/Threads/TikTok скачивают файлы сами — нужен HTTPS-домен).
PUBLIC_URL=https://factory.example.com

DATABASE_URL=postgres://noro:noro@localhost:5432/noro_factory
# Только для автотестов (vitest и Playwright очищают эти базы).
TEST_DATABASE_URL=postgres://noro:noro@localhost:5432/noro_factory_test
# DB_POOL_MAX=10

# Ключ шифрования токенов и API-ключей (AES-256-GCM). Сгенерируйте: openssl rand -base64 48
# Смена ключа делает сохранённые токены нечитаемыми — их придётся подключить заново.
MASTER_KEY=
# Сгенерируйте: openssl rand -base64 48
SESSION_SECRET=

# Регистрация новых пользователей: 1 — открыта, 0 — только приглашения в пространство.
SIGNUP_OPEN=1
# 1 — воркер очереди внутри API-процесса; 0 — запускайте отдельно npm run start:worker.
INLINE_WORKER=1
LOG_LEVEL=info

# Хранилище файлов: local (папка DATA_DIR) или s3 (любое S3-совместимое).
STORAGE_DRIVER=local
DATA_DIR=.data
# S3_BUCKET=
# S3_REGION=ru-central1
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Локальная бесплатная озвучка Piper (npm run tts:setup ставит её в .data/piper).
# PIPER_BIN=.data/piper/venv/bin/piper
# PIPER_VOICES_DIR=.data/piper

# Браузер для рендера Remotion. Если не задан — Remotion скачает chrome-headless-shell сам.
# REMOTION_CHROME_EXECUTABLE=

# Версия Instagram Graph API (по умолчанию v24.0).
# IG_GRAPH_VERSION=v24.0

# Тестовый детерминированный провайдер текста (помечен «ТЕСТ · не ИИ»).
# Никогда не включайте в продакшене.
ALLOW_TEST_PROVIDERS=0
