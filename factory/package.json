{
  "name": "noro-content-factory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch server/main.ts",
    "dev:worker": "tsx watch server/worker-main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx server/main.ts",
    "start:worker": "NODE_ENV=production tsx server/worker-main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "showcase:build": "tsx showcase/build.ts",
    "video:studio": "remotion studio video/index.ts",
    "tts:setup": "bash scripts/setup-piper.sh",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-s3": "3.1157.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/unbounded": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "@tanstack/react-query": "5.105.0",
    "archiver": "8.0.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "remotion": "4.0.539",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "^8.20.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "pino-pretty": "^13.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
