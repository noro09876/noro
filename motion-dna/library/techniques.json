{
  "version": "0.1.0",
  "conventions": {
    "time": "dur — длительность в кадрах при 30 fps (компилятор пересчитывает под fps ролика). keys — [t, value], t от 0 до 1 внутри dur.",
    "hit": "Доля dur (0..1), которая ставится ровно на аудио-якорь (бит, онсет, начало слова). 0 — приём начинается на якоре, 0.3 — удар происходит на 30% длительности.",
    "units": "Единица анимации: char | word | line | block (вся фраза) | layer (клип/кадр целиком).",
    "props": {
      "opacity": "0..1",
      "x, y": "для текста — в em (доля кегля), для слоя (layer) — в % кадра",
      "scale, scaleX, scaleY": "множитель, точка опоры — origin",
      "rotate, skewX": "градусы",
      "blur": "px при ширине кадра 1080",
      "clipT, clipR, clipB, clipL": "маска-врезка с каждой стороны, % размера элемента (100 — полностью скрыто)",
      "tracking": "добавка к межбуквенному интервалу стиля, em (0 — интервал из типографики)",
      "count": "для счётчиков: доля итогового числа 0..1"
    },
    "params": "Значение ключа может быть числом или строкой \"$имя\" / \"-$имя\" — подставляется параметр приёма из стиля.",
    "ai_tell": "Насколько приём сам по себе выдаёт шаблон/нейросеть: low | medium | high. high разрешён только с явным разрешением в стиле.",
    "mask": "mask: true — единица анимации помещается в контейнер с обрезкой по своим границам (с запасом 0.15 em под выносные элементы); движение по y происходит внутри него — классическая «маска» из AE.",
    "draw": "draw — что рисует приём акцента/плашки: rect_behind (плашка за словом), line_under, recolor, count, rect_outline, plate.",
    "modes": "Окна применения: приём входа держит первый ключ до старта и последний после конца; выход и перекраска — без эффекта до старта, держат последний ключ после; камера и переходы действуют только внутри своего окна."
  },
  "easings": {
    "linear": [
      0,
      0,
      1,
      1
    ],
    "out-expo": [
      0.16,
      1,
      0.3,
      1
    ],
    "out-quart": [
      0.25,
      1,
      0.5,
      1
    ],
    "out-cubic": [
      0.33,
      1,
      0.68,
      1
    ],
    "in-quart": [
      0.5,
      0,
      0.75,
      0
    ],
    "in-out-quart": [
      0.76,
      0,
      0.24,
      1
    ],
    "in-out-sine": [
      0.37,
      0,
      0.63,
      1
    ],
    "out-back-soft": [
      0.34,
      1.3,
      0.64,
      1
    ],
    "step": "hold"
  },
  "techniques": [
    {
      "id": "mask_rise_line",
      "category": "text_enter",
      "name": "Выезд строки из-под маски",
      "description": "Строка поднимается снизу, нижний край обрезан невидимой линией. Классика редакционного моушна.",
      "unit": "line",
      "dur": 12,
      "hit": 0.15,
      "stagger": {
        "frames": 3,
        "order": "forward"
      },
      "params": {
        "rise": {
          "type": "number",
          "min": 0.6,
          "max": 1.2,
          "default": 1.0,
          "unit": "em"
        }
      },
      "tracks": [
        {
          "prop": "y",
          "keys": [
            [
              0,
              "$rise"
            ],
            [
              1,
              0
