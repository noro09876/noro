# Public, build-time (embedded in the client bundle — never put secrets here)
VITE_SITE_URL=https://your-site.netlify.app
VITE_CONTACT_EMAIL=
VITE_CONTACT_TELEGRAM=

# Server-side only (Netlify Functions). Set in Netlify UI, never commit.
# Order form delivery to Telegram:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional generic webhook for the order form (e.g. CRM, Make, n8n):
LEAD_WEBHOOK_URL=
# Optional language model for Support / Content OS (Anthropic Messages API):
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
